generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "tenant"]
}

// ==========================================
// PUBLIC SCHEMA MODELS
// ==========================================

model Tenant {
  id                    Int      @id @default(autoincrement())
  slug                  String   @unique @db.VarChar(64)
  subdominio            String?  @unique @db.VarChar(64)
  nome_empresa          String   @db.VarChar(120)
  email_proprietario    String   @db.VarChar(120)
  telefone              String?  @db.VarChar(30)
  senha_hash            String
  status                String   @default("ativo") @db.VarChar(20)
  foto_url              String?
  cor_primaria          String   @default("#0d9488") @db.VarChar(10)
  cor_destaque          String   @default("#f59e0b") @db.VarChar(10)
  cor_fundo             String   @default("#0f172a") @db.VarChar(10)
  cor_texto_principal   String   @default("#ffffff") @db.VarChar(10)
  cor_texto_secundario  String   @default("#94a3b8") @db.VarChar(10)
  agenda_publica_ativa  Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("tenants")
  @@schema("public")
}

// ==========================================
// TENANT SCHEMA MODELS
// ==========================================

model Profissional {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(120)
  telefone    String?  @db.VarChar(30)
  cargo       String   @default("auxiliar") @db.VarChar(30)
  foto_url    String?
  ativo       Boolean  @default(true)
  senha_hash  String?
  created_at  DateTime @default(now()) @db.Timestamptz

  agendamentos          Agendamento[]
  fluxos_caixa          FluxoCaixa[]
  estoque_produtos      EstoqueProduto[]
  estoque_movimentacoes EstoqueMovimentacao[]
  clientes              Cliente[]

  @@map("profissionais")
  @@schema("tenant")
}

model Servico {
  id              Int      @id @default(autoincrement())
  nome            String   @db.VarChar(100)
  descricao       String?
  duracao_minutos Int      @default(60)
  preco           Decimal  @default(0.00) @db.Decimal(10, 2)
  foto_url        String?
  ativo           Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz

  subservicos  Subservico[]
  agendamentos Agendamento[]
  produtos     ServicoProduto[]

  @@map("servicos")
  @@schema("tenant")
}

model Subservico {
  id                        Int      @id @default(autoincrement())
  servico_id                Int
  nome                      String   @db.VarChar(100)
  duracao_adicional_minutos Int      @default(0)
  preco_adicional           Decimal  @default(0.00) @db.Decimal(10, 2)
  foto_url                  String?
  ativo                     Boolean  @default(true)
  created_at                DateTime @default(now()) @db.Timestamptz

  servico      Servico       @relation(fields: [servico_id], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  produtos     SubservicoProduto[]

  @@map("subservicos")
  @@schema("tenant")
}

model Cliente {
  id              Int      @id @default(autoincrement())
  profissional_id Int?
  nome            String   @db.VarChar(100)
  whatsapp        String?  @db.VarChar(30)
  email           String?  @db.VarChar(120)
  observacoes     String?  @db.VarChar(500)
  created_at      DateTime @default(now()) @db.Timestamptz

  profissional Profissional? @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  agendamentos Agendamento[]
  fluxos_caixa FluxoCaixa[]

  @@map("clientes")
  @@schema("tenant")
}

model Agendamento {
  id                    Int      @id @default(autoincrement())
  cliente_id            Int?
  profissional_id       Int?
  servico_id            Int?
  subservico_id         Int?
  data_hora             DateTime @db.Timestamptz
  duracao_total_minutos Int      @default(60)
  valor_total           Decimal  @default(0.00) @db.Decimal(10, 2)
  status                String   @default("agendado") @db.VarChar(20)
  observacao            String?
  tipo_atendimento      String   @default("salao") @db.VarChar(30)
  endereco_externo      String?
  estoque_consumido     Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz

  cliente      Cliente?      @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  profissional Profissional? @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  servico      Servico?      @relation(fields: [servico_id], references: [id], onDelete: SetNull)
  subservico   Subservico?   @relation(fields: [subservico_id], references: [id], onDelete: SetNull)
  fluxos_caixa FluxoCaixa[]

  @@map("agendamentos")
  @@schema("tenant")
}

model FluxoCaixa {
  id              Int      @id @default(autoincrement())
  agendamento_id  Int?
  profissional_id Int?
  cliente_id      Int?
  tipo            String   @db.VarChar(20)
  categoria       String   @default("servico") @db.VarChar(50)
  descricao       String   @db.VarChar(255)
  valor           Decimal  @db.Decimal(10, 2)
  status          String   @default("pago") @db.VarChar(20)
  forma_pagamento String   @default("pix") @db.VarChar(50)
  data_movimento  DateTime @default(now()) @db.Date
  created_at      DateTime @default(now()) @db.Timestamptz

  agendamento  Agendamento?  @relation(fields: [agendamento_id], references: [id], onDelete: SetNull)
  profissional Profissional? @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  cliente      Cliente?      @relation(fields: [cliente_id], references: [id], onDelete: SetNull)

  @@map("fluxo_caixa")
  @@schema("tenant")
}

model EstoqueProduto {
  id              Int      @id @default(autoincrement())
  profissional_id Int?
  nome            String   @db.VarChar(120)
  tipo            String   @default("consumo") @db.VarChar(30)
  quantidade      Int      @default(0)
  estoque_minimo  Int      @default(1)
  custo_unitario  Decimal  @default(0.00) @db.Decimal(10, 2)
  imagem_url      String?
  created_at      DateTime @default(now()) @db.Timestamptz

  profissional      Profissional?         @relation(fields: [profissional_id], references: [id], onDelete: SetNull)
  movimentacoes     EstoqueMovimentacao[]
  servicos          ServicoProduto[]      @relation("ServicoProdutos")
  subservicos       SubservicoProduto[]   @relation("SubservicoProdutos")

  @@map("estoque_produtos")
  @@schema("tenant")
}

model EstoqueMovimentacao {
  id              Int      @id @default(autoincrement())
  produto_id      Int
  profissional_id Int?
  tipo            String   @db.VarChar(20)
  quantidade      Int
  motivo          String?
  created_at      DateTime @default(now()) @db.Timestamptz

  produto      EstoqueProduto @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  profissional Profissional?   @relation(fields: [profissional_id], references: [id], onDelete: SetNull)

  @@map("estoque_movimentacoes")
  @@schema("tenant")
}

model ServicoProduto {
  id              Int      @id @default(autoincrement())
  servico_id      Int
  produto_id      Int
  quantidade_usada Int      @default(1)
  created_at      DateTime @default(now()) @db.Timestamptz

  servico Servico       @relation(fields: [servico_id], references: [id], onDelete: Cascade)
  produto EstoqueProduto @relation("ServicoProdutos", fields: [produto_id], references: [id], onDelete: Cascade)

  @@unique([servico_id, produto_id])
  @@map("servico_produtos")
  @@schema("tenant")
}

model SubservicoProduto {
  id              Int      @id @default(autoincrement())
  subservico_id   Int
  produto_id      Int
  quantidade_usada Int      @default(1)
  created_at      DateTime @default(now()) @db.Timestamptz

  subservico Subservico     @relation(fields: [subservico_id], references: [id], onDelete: Cascade)
  produto    EstoqueProduto @relation("SubservicoProdutos", fields: [produto_id], references: [id], onDelete: Cascade)

  @@unique([subservico_id, produto_id])
  @@map("subservico_produtos")
  @@schema("tenant")
}
